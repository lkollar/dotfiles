Include ~/.orbstack/ssh/config
Include ~/.ssh/1Password/config

Host github
  HostName github.com
  User git

{% if yadm.os == "Darwin" %}
Host *
  AddKeysToAgent yes
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{% endif %}

{% if yadm.user == "lkollar" %}
Host devbox.kollar.me
    HostName devbox.kollar.me
    Port 666
    User lkollar
{% endif %}

{% if yadm.os == "Linux" %}
Host *
  AddKeysToAgent yes
{% endif %}

{% if yadm.class == "work-macos" %}

Include config.d/*
{% endif %}
