Host github
  HostName github.com
  User git

{% if yadm.os == "Darwin" %}
Host * !ubuntu
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_rsa
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{% endif %}

{% if yadm.user == "lkollar" %}
Host devbox.kollar.me
    HostName devbox.kollar.me
    Port 666
    User lkollar
{% endif %}

{% if yadm.os == "Linux" %}
Host *
  AddKeysToAgent yes
{% endif %}

{% if yadm.class == "work-macos" %}

Host ubuntu
    HostName 10.211.55.3
    User parallels
    IdentityFile ~/.ssh/id_ed25519

Include config.d/*
{% endif %}
