{
  "lastChangelogVersion": "1.5.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "packages": [
    "git:github.com/lmilojevicc/pi-zentui",
