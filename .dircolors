# Catppuccin Mocha theme for GNU ls utility
# Palette: https://github.com/catppuccin/catppuccin

# Special files
NORMAL 00;38;5;245 # text (surface2)
RESET 0
DIR 00;38;5;110 # directory (blue)
LINK 00;38;5;168 # symbolic link (pink)
MULTIHARDLINK 00;38;5;245 # text (surface2)
FIFO 48;5;229;38;5;179 # pipe (yellow + peach)
SOCK 48;5;229;38;5;179 # socket (yellow + peach)
DOOR 48;5;229;38;5;179 # door (yellow + peach)
BLK 48;5;229;38;5;245 # block device (yellow + surface2)
CHR 48;5;229;38;5;245 # character device (yellow + surface2)
ORPHAN 48;5;88;38;5;168 # orphan link (red + pink)
SETUID 48;5;168;38;5;229 # setuid file (pink + yellow)
SETGID 48;5;179;38;5;229 # setgid file (peach + yellow)
CAPABILITY 30;41 # file with capability (red background)
STICKY_OTHER_WRITABLE 48;5;110;38;5;229 # sticky and other-writable
OTHER_WRITABLE 48;5;88;38;5;110 # other-writable (red + blue)
STICKY 48;5;110;38;5;229 # sticky (blue + yellow)
EXEC 00;38;5;142 # executable (green)

