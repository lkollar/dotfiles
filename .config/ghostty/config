# Appearance
theme = Gruvbox Dark Hard
font-family = JetBrains Mono NL
font-size = 15

# Boost legibility of too-faint text against its background
minimum-contrast = 2

# Hide titlebar (wezterm: window_decorations = "RESIZE")
macos-titlebar-style = native

# Dim inactive panes (wezterm: inactive_pane_hsb)
unfocused-split-opacity = 0.8

# Left Option acts as terminal Alt
macos-option-as-alt = left

# Selecting text copies straight to the system clipboard
copy-on-select = clipboard

# --- Keybinds ---

# Preserve UK # while left Option handles terminal Alt
keybind = alt+3=text:#
keybind = alt+digit_3=text:#

# HerdR panes: | = side-by-side, - = stacked
keybind = cmd+shift+\=text:\x1bv
keybind = cmd+-=text:\x1b-

# Pane navigation (vim hjkl). Text actions intercept macOS Cmd+H.
keybind = cmd+h=text:\x1bh
keybind = cmd+j=text:\x1bj
keybind = cmd+k=text:\x1bk
keybind = cmd+l=text:\x1bl

# Pane management
keybind = cmd+w=unbind
keybind = cmd+z=unbind
keybind = cmd+shift+enter=unbind

# Pane resizing
keybind = cmd+shift+h=unbind
keybind = cmd+shift+j=unbind
keybind = cmd+shift+k=unbind
keybind = cmd+shift+l=unbind

# Tab navigation
keybind = cmd+shift+[=unbind
keybind = cmd+shift+]=unbind

# Pass terminal-management shortcuts through to Herdr
keybind = cmd+t=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+[=unbind
keybind = cmd+]=unbind

# Ghostty binds both logical and physical forms for digits
keybind = cmd+1=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+2=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+3=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+4=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+5=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+6=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+7=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+8=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+9=unbind
keybind = cmd+digit_9=unbind

# Claude Code line break support (shift+enter -> esc + CR)
keybind = shift+enter=text:\x1b\r
