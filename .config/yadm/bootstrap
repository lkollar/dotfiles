#!/bin/bash
# vi: ft=sh

script_dir=$(dirname "$0")
source "${script_dir}/github_release.sh"

ensure_pew() {
    if ! command -v pew >/dev/null 2>&1; then
        pipx install pew
    else
        echo "pew is already installed"
    fi
}

ensure_zsh() {
    if [[ $SHELL != *zsh ]]; then
        echo "Changing shell to ZSH"
        chsh -s /usr/bin/zsh
    else
        echo "Shell is already ZSH"
    fi
}

ensure_codex() {
    if [[ -x "$HOME/.local/bin/codex" ]]; then
        echo "codex is already installed"
    else
        curl -fsSL https://chatgpt.com/codex/install.sh | sh
    fi
}

# Configure YADM user just for YADM
# https://yadm.io/docs/faq#usage
yadm gitconfig "user.email" kiss.kollar.laszlo@gmail.com
yadm gitconfig "user.name" "László Kiss Kollár"

# check if we are on macos
if [[ "$OSTYPE" == "darwin"* ]]; then
    echo "Detected macOS"

    brew install \
        autoconf \
        automake \
        coreutils \
        fd \
        font-jetbrains-mono \
        font-jetbrains-mono-nerd-font \
        fzf \
        gcc \
        gcc \
        git \
        luarocks \
        neovim \
        node \
        ripgrep \
        rustup \
        shellcheck \
        starship \
        tmux \
        uv

    ensure_pew
    ensure_zsh
fi

if [ -f /etc/debian_version ]; then
    echo "Detected debian-based distro"

    sudo apt update && sudo apt install -y \
        build-essential \
        curl \
        file \
        gcc

    if grep -q "^ID=ubuntu" /etc/os-release; then
        sudo snap install --classic docker
    fi

    # Install tools from GitHub releases
    local_bin="$HOME/.local/bin"
    mkdir -p "$local_bin"
    download_github_release "junegunn/fzf" "fzf" "$local_bin"
    download_github_release "mvdan/sh" "shfmt" "$local_bin"
    download_github_release "starship/starship" "starship" "$local_bin"
    download_github_release "neovim/neovim" "neovim" "$local_bin"

    # Ensure "nvim" is available alongside the "neovim" binary
    ln -sf "$local_bin/neovim" "$local_bin/nvim"

    ensure_pew
    ensure_zsh
fi

if [ -f /etc/arch-release ]; then
    echo "Detected arch-based distro"

    sudo pacman -Syu --noconfirm \
        autoconf \
        automake \
        fzf \
        gcc \
        keychain \
        luarocks \
        man-db \
        man-pages \
        neovim \
        nodejs \
        npm \
        python-pipx \
        ripgrep \
        rustup \
        shellcheck \
        starship \
        tmux \
        unzip \
        uv \
        zsh

    ensure_pew
    ensure_zsh
fi

if grep -q "^ID=fedora$" /etc/os-release; then
    echo "Detected Fedora"

    sudo dnf install -y \
        curl \
        file \
        fzf \
        gcc \
        gcc-c++ \
        git \
        luarocks \
        make \
        neovim \
        nodejs \
        pipx \
        ripgrep \
        rustup \
        shellcheck \
        tmux \
        unzip \
        uv \
        zsh

    local_bin="$HOME/.local/bin"
    mkdir -p "$local_bin"
    download_github_release "starship/starship" "starship" "$local_bin"

    ensure_pew
    ensure_zsh
fi

ensure_codex

ZPLUG_HOME=~/.zplug
if [[ -e "$ZPLUG_HOME" ]]; then
    echo "zplug already installed"
else
    echo "Installing zplug"
    git clone https://github.com/zplug/zplug "$ZPLUG_HOME"
fi

if [[ ! -e ~/.tmux/plugins/tpm ]]; then
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
    cd ~/.tmux/plugins/tpm/scripts && ./install_plugins.sh
fi
