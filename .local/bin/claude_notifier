#!/usr/bin/env python3
"""
Terminal notifier for Claude Code hooks
Sends notifications via terminal-notifier on macOS
"""

import json
import sys
import os
import subprocess
import shutil


def main() -> None:
    # Check if terminal-notifier is available
    if not shutil.which("terminal-notifier"):
        print("Error: terminal-notifier not installed", file=sys.stderr)
        sys.exit(1)

    # Read hook input from stdin
    stdin_data = sys.stdin.read() if not sys.stdin.isatty() else ""
    try:
        hook_input = json.loads(stdin_data) if stdin_data else {}
    except json.JSONDecodeError:
        print("Error: Invalid JSON input", file=sys.stderr)
        sys.exit(1)

    # Extract message from hook input with type validation
    message = hook_input.get("message") or hook_input.get("notification") or ""
    if not isinstance(message, str) or not message:
        print("Error: No valid message found in hook input", file=sys.stderr)
        sys.exit(1)

    # Get working directory for group
    cwd = os.getcwd()

    # Get WezTerm pane ID from environment
    wezterm_pane = os.getenv("WEZTERM_PANE", "")

    # Build terminal-notifier command matching settings.json
    cmd = [
        "terminal-notifier",
        "-message", message,
        "-title", "Claude Code",
        "-group", f"{cwd}:hook",
        "-activate", "com.github.wez.wezterm"
    ]

    # Add execute flag if WezTerm pane ID is available
    if wezterm_pane:
        wezterm_path = shutil.which("wezterm") or "/opt/homebrew/bin/wezterm"
        cmd.extend([
            "-execute", f"{wezterm_path} cli activate-pane --pane-id {wezterm_pane}"
        ])

    try:
        subprocess.run(cmd, check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as e:
        stderr = e.stderr.strip() if e.stderr else str(e)
        print(f"terminal-notifier failed: {stderr}", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print("Error: terminal-notifier not found", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
