#!/usr/bin/env python3
"""Terminal notifier for coding-agent hooks (tool-agnostic)."""

import json
import os
import shutil
import subprocess
import sys

DEFAULT_TITLE = "Assistant"
MAX_LEN = 180


def _short(text: str, limit: int = MAX_LEN) -> str:
    text = " ".join(text.strip().split())
    if len(text) <= limit:
        return text
    return text[: limit - 1].rstrip() + "…"


def _derive_message(payload: dict) -> str:
    for key in ("message", "notification", "summary"):
        value = payload.get(key)
        if isinstance(value, str) and value.strip():
            return _short(value)

    last = payload.get("last_assistant_message")
    if isinstance(last, str) and last.strip():
        return _short(last)

    event = payload.get("hook_event_name")
    if event == "SessionStart":
        cwd = payload.get("cwd")
        if isinstance(cwd, str) and cwd:
            return f"Session started in {os.path.basename(cwd) or cwd}"
        return "Session started"
    if event == "Stop":
        return "Turn finished"

    return "Notification"


def _notify(message: str) -> None:
    has_terminal_notifier = shutil.which("terminal-notifier") is not None

    if has_terminal_notifier:
        cwd = os.getcwd()
        wezterm_pane = os.getenv("WEZTERM_PANE", "")
        cmd = [
            "terminal-notifier",
            "-message",
            message,
            "-title",
            DEFAULT_TITLE,
            "-group",
            f"{cwd}:hook",
            "-activate",
            "com.github.wez.wezterm",
        ]
        if wezterm_pane:
            wezterm_path = shutil.which("wezterm") or "/opt/homebrew/bin/wezterm"
            cmd.extend(["-execute", f"{wezterm_path} cli activate-pane --pane-id {wezterm_pane}"])

        try:
            subprocess.run(cmd, check=True, capture_output=True, text=True)
            return
        except (subprocess.CalledProcessError, FileNotFoundError):
            pass

    if os.getenv("TMUX"):
        try:
            subprocess.run(["tmux", "display-message", "-d", "0", f"\a{DEFAULT_TITLE}: {message}"], check=True)
            return
        except (subprocess.CalledProcessError, FileNotFoundError):
            pass

    print(f"{DEFAULT_TITLE}: {message}", file=sys.stderr)


def main() -> int:
    stdin_data = sys.stdin.read() if not sys.stdin.isatty() else ""
    payload: dict = {}
    if stdin_data.strip():
        try:
            parsed = json.loads(stdin_data)
            if isinstance(parsed, dict):
                payload = parsed
        except json.JSONDecodeError:
            payload = {}

    _notify(_derive_message(payload))

    if payload.get("hook_event_name") == "Stop":
        # Stop hooks require JSON stdout when command exits 0.
        print('{"continue": true}')

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
